<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración de artefacto "installer" para SignPath (copiar en el proyecto de SignPath).
     El artefacto es el instalador NVTabs-Setup-<versión>.exe subido por GitHub Actions (llega como ZIP). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="NVTabs-Setup-*.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
